{
  "compilerOptions": {
    "target": "ES2015",
    "module": "Node16",
    "lib": ["es6", "dom"],
    "moduleResolution": "Node16",
    "types": ["jest"],
    "rootDir": "./src",
    "outDir": "./lib",
    "preserveConstEnums": true,
    "declaration": true,
    "importHelpers": true,
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true
  }
}
