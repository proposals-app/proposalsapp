{
  "name": "proposalsapp",
  "version": "0.1.0",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tsconfig/recommended": "^1.0.13",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-storybook": "^10.5.3",
    "globals": "^17.7.0",
    "npm-check-updates": "^22.2.9",
    "prettier": "^3.9.5",
    "prettier-plugin-classnames": "^0.10.4",
    "prettier-plugin-merge": "^0.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.1",
  "private": true,
  "scripts": {
    "build-email-service": "pnpm --filter @proposalsapp/email-service run build",
    "build-mapping-agent": "pnpm --filter @proposalsapp/mapping-agent run build",
    "build-emails": "pnpm --filter @proposalsapp/emails run build",
    "build-web": "pnpm --filter @proposalsapp/web run build",
    "start-email-service": "pnpm --filter @proposalsapp/email-service run start",
    "start-mapping-agent": "pnpm --filter @proposalsapp/mapping-agent run start",
    "start-web": "pnpm --filter @proposalsapp/web run start",
    "update-deps": "./update-deps.sh",
    "lint": "eslint . --config eslint.config.mjs --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --config eslint.config.mjs --fix --cache --cache-location .eslintcache",
    "format": "prettier --check --config prettier.config.mjs .",
    "format:fix": "prettier --write --config prettier.config.mjs .",
    "lint:rust": "cargo lint",
    "lint:rust:fix": "cargo fix",
    "format:rust": "cargo format",
    "format:rust:check": "cargo check-format",
    "check": "pnpm lint && pnpm format && pnpm lint:rust && pnpm format:rust:check",
    "fix": "pnpm lint:fix && pnpm format:fix && pnpm lint:rust:fix && pnpm format:rust",
    "verify-setup": "./scripts/verify-setup.sh"
  },
  "type": "module"
}
